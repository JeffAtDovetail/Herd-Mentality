{
  "name": "herd-mentality",
  "version": "0.2.0",
  "private": true,
  "description": "A Herd Mentality-style party game for big meetings: scan a QR code, join from your phone, match the herd.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "bedrock:smoke": "node scripts/bedrock-smoke.js",
    "prod": "bash scripts/prod.sh"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1139.0",
    "@aws-sdk/credential-providers": "^3.1139.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  }
}
