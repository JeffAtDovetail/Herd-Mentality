AWS_PROFILE=dev
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: AI grouping of free-text answers (on by default, falls back to text matching)
# LLM_GROUPING=off
# LLM_GROUPING_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# LLM_TIMEOUT_MS=8000

# Optional: bots fill games with fewer than 3 players (0 = off); LLM_BOTS=off for canned bot answers
# BOTS_MIN_PLAYERS=3
# LLM_BOTS=off

# Option B (online via a tunnel) — see README. Only needed for the tunnel scripts.
# Cloudflare Tunnel (npm run tunnel:cloudflare):
# CLOUDFLARE_TUNNEL_NAME=herd
# CLOUDFLARE_PUBLIC_URL=https://herd.your-domain.com
# ngrok (npm run tunnel:ngrok), optional reserved domain:
# NGROK_URL=https://your-name.ngrok.app
